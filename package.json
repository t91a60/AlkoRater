{
  "name": "alko-rater",
  "version": "2.12.0",
  "description": "Progressive Web App do oceniania alkoholi — iOS feel, offline-first, mobile-first. v2.12: naprawiony fallback miniatur, powiadomienie o błędzie zapisu, flow aktualizacji PWA i haptyka na iOS (best-effort)",
  "main": "index.html",
  "scripts": {
    "dev": "npx serve . -p 3000 --single",
    "dev:cache": "npx serve . -p 3000 --single",
    "build": "echo 'Statyczna PWA – nie ma builda'",
    "preview": "npm run dev:cache",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint src/js/",
    "lint:css": "stylelint src/css/",
    "format": "prettier --write \"src/**/*.{js,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jsdom": "^24.1.3",
    "prettier": "^3.0.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "vitest": "^1.6.1"
  },
  "keywords": [
    "pwa",
    "alcohol",
    "rating",
    "beer",
    "offline",
    "ios-feel",
    "mobile-first"
  ],
  "author": "https://github.com/t91a60",
  "license": "MIT"
}
