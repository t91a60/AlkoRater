{
    "name": "alko-rater",
    "version": "2.14.0-rc.1",
    "description": "Aplikacja PWA do przeglądania alkoholi i zapisywania własnych ocen, także offline.",
    "main": "index.html",
    "type": "module",
    "scripts": {
        "dev": "node scripts/serve.mjs",
        "dev:cache": "node scripts/serve.mjs --cache",
        "build": "node scripts/build.mjs",
        "preview": "node scripts/serve.mjs --root dist",
        "lint": "npm run lint:js && npm run lint:css",
        "lint:js": "eslint src/js/ scripts/ *.config.mjs service-worker.js tests/e2e/",
        "lint:css": "stylelint src/css/",
        "format": "prettier --write \"src/**/*.{js,css}\"",
        "format:check": "prettier --check \"src/**/*.{js,css}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "check:data": "node scripts/audit-catalog.mjs"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.64.1",
        "eslint": "^10.13.0",
        "fake-indexeddb": "^6.2.6",
        "globals": "^17.13.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "stylelint": "^16.26.1",
        "stylelint-config-standard": "^36.0.1",
        "vitest": "^5.0.5"
    },
    "keywords": [
        "pwa",
        "alcohol",
        "rating",
        "beer",
        "offline",
        "ios-feel",
        "mobile-first"
    ],
    "author": "https://github.com/t91a60",
    "license": "Apache-2.0"
}
